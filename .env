# ============================================================
# VBank Microservices - Environment Configuration
# ============================================================
# Copy this file to .env.local and override values for local
# development outside of Docker Compose.
# ============================================================

# --- Database Hosts (use service names for Docker, localhost for local dev) ---
DB_USER_HOST=user-db
DB_USER_PORT=5432
DB_USER_NAME=user_db
DB_USER_USER=user_user
DB_USER_PASS=user_pass

DB_ACCOUNT_HOST=account-db
DB_ACCOUNT_PORT=5432
DB_ACCOUNT_NAME=account_db
DB_ACCOUNT_USER=account_user
DB_ACCOUNT_PASS=account_pass

DB_TRANSACTION_HOST=transaction-db
DB_TRANSACTION_PORT=5432
DB_TRANSACTION_NAME=transaction_db
DB_TRANSACTION_USER=transaction_user
DB_TRANSACTION_PASS=transaction_pass

DB_LOGGING_HOST=logging-db
DB_LOGGING_PORT=5432
DB_LOGGING_NAME=logging_db
DB_LOGGING_USER=logging_user
DB_LOGGING_PASS=logging_pass

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka-server:9092

# --- Eureka ---
EUREKA_HOST=service-registry
EUREKA_PORT=8761

# --- Exposed Ports (host side of port mapping) ---
EXPOSED_PORT_USER_DB=5051
EXPOSED_PORT_ACCOUNT_DB=5050
EXPOSED_PORT_TRANSACTION_DB=5053
EXPOSED_PORT_LOGGING_DB=5054
EXPOSED_PORT_REGISTRY=8761
EXPOSED_PORT_ACCOUNT=8081
EXPOSED_PORT_USER=8082
EXPOSED_PORT_TRANSACTION=8083
EXPOSED_PORT_LOGGING=8084
EXPOSED_PORT_BFF=8085
EXPOSED_PORT_KAFKA=9092
EXPOSED_PORT_KAFKA_UI=8073

# --- Internal Server Ports (container side) ---
SERVER_PORT_ACCOUNT=8083
SERVER_PORT_USER=8088
SERVER_PORT_TRANSACTION=8089
SERVER_PORT_LOGGING=8080
SERVER_PORT_BFF=8090
SERVER_PORT_REGISTRY=8761

# --- Logging ---
SPRING_LOG_LEVEL=DEBUG
